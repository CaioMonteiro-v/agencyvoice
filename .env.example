# Provedor: auto | elevenlabs | local
# auto = ElevenLabs se houver API key; senão AgencyVoice AI local
VOICE_PROVIDER=auto

# Cole a chave secreta que começa com sk_ (Profile → API Keys → Reveal/Copy).
# Não use o "Key ID" (hash hex).
ELEVENLABS_API_KEY=

# Motor local AgencyVoice AI
AI_URL=http://127.0.0.1:8000

# Porta do gateway Node
PORT=3001
